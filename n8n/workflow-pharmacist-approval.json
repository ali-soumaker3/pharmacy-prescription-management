{
  "name": "Pharmacy AI - 2. Pharmacist Approval (Telegram + Web)",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "id": "telegram-trigger-callback",
      "name": "Telegram Trigger: Кнопки фармацевта",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [180, 200]
    },
    {
      "parameters": {
        "jsCode": "const cb = $input.first().json.callback_query;\nconst [decision, orderId] = String(cb?.data || '').split(':');\nconst status = decision === 'approve' ? 'approved' : 'rejected';\nreturn [{\n  json: {\n    callback_query_id: cb?.id || '',\n    order_id: orderId,\n    decision,\n    status,\n    pharmacist_note: decision === 'approve' ? 'Одобрено фармацевтом в Telegram' : 'Отклонено фармацевтом в Telegram',\n    chat_id: cb?.message?.chat?.id,\n    message_id: cb?.message?.message_id,\n    original_text: cb?.message?.text || ''\n  }\n}];"
      },
      "id": "code-parse-telegram",
      "name": "Code: Разбор callback Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 200]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://igzegdgmthsanxxaagdq.supabase.co/rest/v1/orders?id=eq.' + $json.order_id + '&status=eq.pending_approval' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.status, pharmacist_note: $json.pharmacist_note }) }}",
        "options": {}
      },
      "id": "supabase-update-tg",
      "name": "Supabase: Обновить статус (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 200]
    },
    {
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $('Code: Разбор callback Telegram').first().json.callback_query_id }}",
        "additionalFields": {
          "text": "={{ $('Code: Разбор callback Telegram').first().json.status === 'approved' ? 'Заказ одобрен' : 'Заказ отклонён' }}"
        }
      },
      "id": "telegram-answer-callback",
      "name": "Telegram: Подтвердить нажатие",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "editMessageText",
        "chatId": "={{ $('Code: Разбор callback Telegram').first().json.chat_id }}",
        "messageId": "={{ $('Code: Разбор callback Telegram').first().json.message_id }}",
        "text": "={{ $('Code: Разбор callback Telegram').first().json.original_text + '\\n\\n' + ($('Code: Разбор callback Telegram').first().json.status === 'approved' ? '✅ Статус: ОДОБРЕНО ФАРМАЦЕВТОМ' : '❌ Статус: ОТКЛОНЕНО ФАРМАЦЕВТОМ') }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "telegram-edit-result",
      "name": "Telegram: Обновить карточку заказа",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1220, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "approve-order",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-approve",
      "name": "Webhook: Решение из веб-панели",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 440]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nreturn [{\n  json: {\n    order_id: body.order_id,\n    decision: body.decision,\n    status: body.status,\n    pharmacist_note: body.pharmacist_note || null\n  }\n}];"
      },
      "id": "code-parse-web",
      "name": "Code: Разбор запроса с сайта",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 440]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://igzegdgmthsanxxaagdq.supabase.co/rest/v1/orders?id=eq.' + $json.order_id + '&status=eq.pending_approval' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.status, pharmacist_note: $json.pharmacist_note }) }}",
        "options": {}
      },
      "id": "supabase-update-web",
      "name": "Supabase: Обновить статус (Web)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 440]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ order_id: $('Code: Разбор запроса с сайта').first().json.order_id, status: $('Code: Разбор запроса с сайта').first().json.status, pharmacist_note: $('Code: Разбор запроса с сайта').first().json.pharmacist_note }) }}",
        "options": {}
      },
      "id": "respond-approve",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 440]
    }
  ],
